# ==================================================
# Boya Mallikarjuna Portfolio — Environment Variables
# ==================================================

# The email address that receives visitor contact inquiries
CONTACT_EMAIL=boyamallikarjuna183@gmail.com

# Transactional Email Service API Key (e.g. Resend 're_...' or SendGrid 'SG....')
EMAIL_API_KEY=your_email_api_key_here

# Verified Sender Address
# For Resend initial testing, you can use: Portfolio <onboarding@resend.dev>
# For custom domain in production: Portfolio <contact@yourdomain.com>
EMAIL_FROM=Portfolio <onboarding@resend.dev>

# Optional: Specific email service override ('resend' | 'sendgrid' | 'smtp')
# Defaults to auto-detection based on API key format
EMAIL_SERVICE=resend

# Optional: SMTP Configuration (if using direct Gmail / custom SMTP instead of Resend/SendGrid)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=boyamallikarjuna183@gmail.com
# SMTP_PASS=your_16_char_gmail_app_password
